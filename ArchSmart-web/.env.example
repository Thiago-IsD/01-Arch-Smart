# Copie este arquivo para ".env.local" (na mesma pasta) e preencha os valores reais.
# Nunca commite o ".env.local" — ele já está no .gitignore.
# Ver docs/dev/ambiente.md para o passo a passo completo.
# As três variáveis abaixo são obrigatórias — sem elas, src/lib/env.ts lança
# um erro de validação (Zod) assim que qualquer página é carregada.

# URL da API backend (ArchSmart-api). Local: http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL do projeto Supabase — o mesmo projeto usado pelo backend.
# Obtenha em Project Settings > API, no painel do Supabase, ou peça a
# alguém do time.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon) do mesmo projeto Supabase. Também em Project Settings > API.
# É uma chave pública por design (fica exposta no bundle do navegador), mas
# ainda assim específica do projeto — peça a alguém do time.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
